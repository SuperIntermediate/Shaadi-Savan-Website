# ==============================================================================
# SHAADI-SAVAN ATELIER — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure real credentials.
# NEVER commit real credentials, secrets, or .env files to source control.
# ==============================================================================

# Application Environment ('development' | 'production')
NODE_ENV=development

# Server Network Configuration
BACKEND_PORT=5000
PORT=5000

# Security: JWT Authentication Secret
# REQUIRED in production. Must be at least 32 cryptographically random characters.
# Generate one using: openssl rand -base64 32
JWT_SECRET=your_32_character_minimum_random_secret_here_replace_me

# Security: Strict CORS Allowed Origins (Comma-separated)
# In production, restrict exclusively to your official deployed frontend domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shaadisavan.com

# Database: MongoDB Atlas Connection String
# Leave unset in local development to run in resilient local JSON storage mode.
# REQUIRED in production. Example: mongodb+srv://username:password@cluster.mongodb.net/shaadi_savan?retryWrites=true&w=majority
MONGODB_URI=

# Media Storage: Cloudinary Server-Side Media Engine (Optional / Recommended for Production)
# When provided, all high-resolution wedding photography and cinema uploads stream directly to Cloudinary.
# When omitted, media is stored locally in /public/uploads with magic-byte signature validation.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Administrator Provisioning (Optional override for fresh setups)
ADMIN_INITIAL_EMAIL=admin@shaadisavan.com
ADMIN_INITIAL_PASSWORD=
