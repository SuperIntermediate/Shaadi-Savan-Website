# ===================================================================
# SHAADI-SAVAN ATELIER — PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================

# Environment: 'production' or 'development'
NODE_ENV=production

# Server Port
BACKEND_PORT=5000

# Security: JWT Signing Secret (CRITICAL: Must be at least 32 characters long)
# Generate a strong key using: openssl rand -base64 32
JWT_SECRET=replace_with_your_own_secure_random_32_char_secret_key_here

# Security: CORS Allowed Origins (Comma-separated list of approved domains)
# Example: https://shaadisavan.com,https://www.shaadisavan.com,https://admin.shaadisavan.com
ALLOWED_ORIGINS=https://shaadisavan.com,https://www.shaadisavan.com

# Database: MongoDB Connection String (Optional: falls back to local JSON store if omitted)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shaadi_savan?retryWrites=true&w=majority

# AI Studio / Gemini API Key (If using generative features)
GEMINI_API_KEY=your_gemini_api_key_here
